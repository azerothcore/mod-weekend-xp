[worldserver]

# XPWeekend.Announce
# 	Annnounces to the player that the module is enabled even if its not the weekend.
# default: 1 = true 
#

XPWeekend.Announce = 0

# XPWeekend.Enabled
#     Enable or disable the module. When enabled, the bonuses below apply on
#     the days and hours set with XPWeekend.Days, XPWeekend.StartHour and
#     XPWeekend.EndHour (Friday to Sunday by default).
#     0 = disabled, 1 = enabled
#     Default: 1 (Enabled)
#

XPWeekend.Enabled = 1

# XPWeekend.xpAmount
#     Decimal. The bonus rate of the weekend event, on top of the rates set in worldserver.conf.
#     Multiplies the experience players get, and also every other bonus that is enabled below
#     (professions, weapon skills, reputation, money).
#     1 = no bonus, 2 = double, 3 = triple, and so on.
#     A value between 0 and 1 only lowers XP; for the other bonuses it is treated as 1
#     (no bonus), so they never reduce skill points, reputation or money.
#     0 or less is treated as 1 for every bonus.
#     Skill points are whole numbers, so the multiplied skill gain is rounded down
#     (e.g. a gain of 1 point at 1.5 stays 1 point; use 2, 3, ... for skills).
#     Default: 2 (double)
#

XPWeekend.xpAmount = 2

# XPWeekend.XPEnabled
#     Enable or disable the XP bonus (including the Joyous Journeys XP bonus).
#     Set it to 0 to give only the other bonuses, for example a profession-only weekend.
#     0 = disabled, 1 = enabled
#     Default: 1 (Enabled)

XPWeekend.XPEnabled = 1

# XPWeekend.IndividualXPEnabled
#     Allows players to set their own XP rates during the weekend through the weekendxp rates command.
#     Default: 0 (Disabled)

XPWeekend.IndividualXPEnabled = 0

# XPWeekend.MaxAllowedRate
#     Max allowed rates players may set while using the weekendxp rates command.
#     Default: 2
#

XPWeekend.MaxAllowedRate = 2

# XPWeekend.AlwaysEnabled
#     Forces the weekend xp bonus event to always be enabled regardless of the day. Use this for debugging.
#     Default: 0 (Disabled)
#

XPWeekend.AlwaysEnabled = 0

# XPWeekend.Days
#     Days the bonus starts on, divided by "," without spaces.
#     0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday,
#     5 = Friday, 6 = Saturday
#     An empty value means the bonus never starts (unless AlwaysEnabled = 1).
#     Default: "5,6,0" (Friday, Saturday, Sunday)
#

XPWeekend.Days = "5,6,0"

# XPWeekend.StartHour
#     Hour (server local time) the bonus starts on each day in XPWeekend.Days.
#     Days and hours follow the clock and time zone of the machine running
#     the worldserver (often UTC). This is the "Realm time" of the in-game
#     clock, not each player's local time.
#     Range: 0-23
#     Default: 0 (00:00)
#

XPWeekend.StartHour = 0

# XPWeekend.EndHour
#     Hour (server local time) the bonus ends. It is exclusive: the bonus is
#     active until EndHour:00, not including it.
#     If lower than StartHour, the window crosses midnight and ends on the
#     next day (Saturday rolls over into Sunday).
#     If equal to StartHour, the window lasts 24 hours (0 and 0 = whole day).
#     Example: Days = "5", StartHour = 22, EndHour = 2
#              = Friday 22:00 to Saturday 02:00
#     Range: 0-23
#     Default: 0
#

XPWeekend.EndHour = 0

# XPWeekend.AnnounceStartEnd
#     Broadcasts XPWeekend.StartMessage to every online player when the
#     bonus starts (at the XPWeekend.StartHour of a day in XPWeekend.Days)
#     and XPWeekend.EndMessage when it ends (at XPWeekend.EndHour).
#     Windows that touch each other count as one event: with the default
#     days and hours the broadcasts are sent on Friday 00:00 and Monday
#     00:00 only. There is no broadcast when the server starts during the
#     bonus.
#     Turning the bonus on or off with XPWeekend.Enabled or
#     XPWeekend.AlwaysEnabled and `.reload config` also counts as a
#     start or an end.
#     XPWeekend.StartMessage is also sent to each player who logs in while
#     the bonus is active, except while XPWeekend.AlwaysEnabled = 1.
#     Default: 0 (Disabled)
#

XPWeekend.AnnounceStartEnd = 0

# XPWeekend.StartMessage
#     Text sent when the bonus starts and at login during the bonus.
#     Only used when XPWeekend.AnnounceStartEnd = 1.
#     An empty value disables this message.
#     Default: "The Double XP Event has started!"
#

XPWeekend.StartMessage = "The Double XP Event has started!"

# XPWeekend.EndMessage
#     Text sent when the bonus ends.
#     Only used when XPWeekend.AnnounceStartEnd = 1.
#     An empty value disables this message.
#     Default: "The Double XP Event has ended!"
#

XPWeekend.EndMessage = "The Double XP Event has ended!"

# XPWeekend.QuestOnly
#     Restricts the experience bonus to quest rewards only.
#     Default: 0 (Disabled, both creatures and quests are affected)
#

XPWeekend.QuestOnly = 0

# XPWeekend.MaxLevel = 80
#     Restricts the experience bonus to characters of a certain level.
#     Characters with a higher level than this will not receive any bonus experience.
#

XPWeekend.MaxLevel = 80

# XPWeekend.IsDKStartZoneRequired = 0
#     If set to 1 (enabled), players must have completed the Death Knight starting zone to receive the bonus experience.
#     Default: 0 (Disabled)

XPWeekend.IsDKStartZoneRequired = 0

# The profession, weapon skill, reputation and money bonuses below use the XPWeekend.xpAmount
# rate whenever the weekend event is active (XPWeekend.Enabled in its time window, or
# XPWeekend.AlwaysEnabled). They are not affected by XPWeekend.XPEnabled, XPWeekend.MaxLevel,
# XPWeekend.QuestOnly, XPWeekend.IsDKStartZoneRequired or the `.weekendxp rate` command.
# They are all disabled by default: set the ones you want to 1.

# XPWeekend.ProfessionEnabled
#     Enable or disable the profession bonus. Each successful skill-up gives
#     SkillGain.Gathering / SkillGain.Crafting (worldserver.conf) x XPWeekend.xpAmount points.
#     Applies to gathering professions, Lockpicking, prospecting, milling, crafting professions,
#     Cooking, First Aid and Fishing. The skill-up chance is unchanged and the skill never goes
#     above its max.
#     0 = disabled, 1 = enabled
#     Default: 0 (Disabled)

XPWeekend.ProfessionEnabled = 0

# XPWeekend.WeaponSkillEnabled
#     Enable or disable the weapon skill bonus. Each successful weapon skill-up (swords, axes,
#     maces, bows, unarmed, ...) gives SkillGain.Weapon x XPWeekend.xpAmount points, and each
#     successful Defense skill-up gives SkillGain.Defense x XPWeekend.xpAmount points.
#     The skill-up chance is unchanged and the skill never goes above its max (5 x level).
#     0 = disabled, 1 = enabled
#     Default: 0 (Disabled)

XPWeekend.WeaponSkillEnabled = 0

# XPWeekend.ReputationEnabled
#     Enable or disable the reputation bonus. Reputation gains from kills and quests are
#     multiplied by XPWeekend.xpAmount, and also by XPWeekend.JoyousJourneysRepRate when that
#     event is active. Reputation losses are never multiplied.
#     Factions excluded by XPWeekend.ExcludeInsaneReps get no bonus.
#     The Joyous Journeys reputation bonus does not depend on this option.
#     0 = disabled, 1 = enabled
#     Default: 0 (Disabled)

XPWeekend.ReputationEnabled = 0

# XPWeekend.MoneyEnabled
#     Enable or disable the money bonus. Looted gold (shared in groups after multiplying) and
#     quest reward money (including the max-level gold paid instead of XP) are multiplied by
#     XPWeekend.xpAmount. Trade, mail, auction house, vendor and any other money is never
#     multiplied. Quest windows and the quest complete message still show the base amount.
#     0 = disabled, 1 = enabled
#     Default: 0 (Disabled)

XPWeekend.MoneyEnabled = 0

# XPWeekend.IsJoyousJourneysActive = 0
#     Promotional event, adds yet another layer of bonus on top of the current bonus (yay!)
#     Ignored while a window is set with the `.weekendxp joyousjourneys schedule`
#     command; the scheduled window decides whether the event is active instead.
#     Default: 0 (Disabled)

XPWeekend.IsJoyousJourneysActive = 0

# XPWeekend.JoyousJourneysXPRate = 1
#     Bonus experience rate during joyous journeys.
#     ADDS to the base one. So if base 2x + 1x from this = 3x (50% increase).
#     Default: 1

XPWeekend.JoyousJourneysXPRate = 1

# XPWeekend.JoyousJourneysRepRate = 1.10
#     Reputation bonus while joyous journeys is active.
#     Default: 1.10 (10%)

XPWeekend.JoyousJourneysRepRate = 1.10

# XPWeekend.ExcludeInsaneReps = 1
#     Exclude the insane title reputations e.g ravenholdt
#     Default: 1 (Enabled)

XPWeekend.ExcludeInsaneReps = 1
