[worldserver]

# XPWeekend.Announce
# 	Annnounces to the player that the module is enabled even if its not the weekend.
# default: 1 = true 
#

XPWeekend.Announce = 0

# XPWeekend.Enabled
#	Enable or Disable the module.
#default: 1 = enable
#

XPWeekend.Enabled = 1

# XPWeekend.xpAmount
#	Allows the config file to set the amount of times xp is given
# default = 2 (double)
#
XPWeekend.xpAmount = 2

# XPWeekend.IndividualXPEnabled
#     Allows players to set their own XP rates during the weekend through the weekendxp rates command.
#     Default: 0 (Disabled)

XPWeekend.IndividualXPEnabled = 0

# XPWeekend.MaxAllowedRate
#     Max allowed rates players may set while using the weekendxp rates command.
#     Default: 2
#

XPWeekend.MaxAllowedRate = 2

# XPWeekend.AlwaysEnabled
#     Forces the weekend xp bonus event to always be enabled regardless of the day. Use this for debugging.
#     Default: 0 (Disabled)
#

XPWeekend.AlwaysEnabled = 0

# XPWeekend.Days
#     Days the bonus starts on, divided by "," without spaces.
#     0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday,
#     5 = Friday, 6 = Saturday
#     An empty value means the bonus never starts (unless AlwaysEnabled = 1).
#     Default: "5,6,0" (Friday, Saturday, Sunday)
#

XPWeekend.Days = "5,6,0"

# XPWeekend.StartHour
#     Hour (server local time) the bonus starts on each day in XPWeekend.Days.
#     Days and hours follow the clock and time zone of the machine running
#     the worldserver (often UTC). This is the "Realm time" of the in-game
#     clock, not each player's local time.
#     Range: 0-23
#     Default: 0 (00:00)
#

XPWeekend.StartHour = 0

# XPWeekend.EndHour
#     Hour (server local time) the bonus ends. It is exclusive: the bonus is
#     active until EndHour:00, not including it.
#     If lower than StartHour, the window crosses midnight and ends on the
#     next day (Saturday rolls over into Sunday).
#     If equal to StartHour, the window lasts 24 hours (0 and 0 = whole day).
#     Example: Days = "5", StartHour = 22, EndHour = 2
#              = Friday 22:00 to Saturday 02:00
#     Range: 0-23
#     Default: 0
#

XPWeekend.EndHour = 0

# XPWeekend.AnnounceStartEnd
#     Broadcasts XPWeekend.StartMessage to every online player when the
#     bonus starts (at the XPWeekend.StartHour of a day in XPWeekend.Days)
#     and XPWeekend.EndMessage when it ends (at XPWeekend.EndHour).
#     Windows that touch each other count as one event: with the default
#     days and hours the broadcasts are sent on Friday 00:00 and Monday
#     00:00 only. There is no broadcast when the server starts during the
#     bonus.
#     Turning the bonus on or off with XPWeekend.Enabled or
#     XPWeekend.AlwaysEnabled and `.reload config` also counts as a
#     start or an end.
#     XPWeekend.StartMessage is also sent to each player who logs in while
#     the bonus is active, except while XPWeekend.AlwaysEnabled = 1.
#     Default: 0 (Disabled)
#

XPWeekend.AnnounceStartEnd = 0

# XPWeekend.StartMessage
#     Text sent when the bonus starts and at login during the bonus.
#     Only used when XPWeekend.AnnounceStartEnd = 1.
#     An empty value disables this message.
#     Default: "The Double XP Event has started!"
#

XPWeekend.StartMessage = "The Double XP Event has started!"

# XPWeekend.EndMessage
#     Text sent when the bonus ends.
#     Only used when XPWeekend.AnnounceStartEnd = 1.
#     An empty value disables this message.
#     Default: "The Double XP Event has ended!"
#

XPWeekend.EndMessage = "The Double XP Event has ended!"

# XPWeekend.QuestOnly
#     Restricts the experience bonus to quest rewards only.
#     Default: 0 (Disabled, both creatures and quests are affected)
#

XPWeekend.QuestOnly = 0

# XPWeekend.MaxLevel = 80
#     Restricts the experience bonus to characters of a certain level.
#     Characters with a higher level than this will not receive any bonus experience.
#

XPWeekend.MaxLevel = 80

# XPWeekend.IsDKStartZoneRequired = 0
#     If set to 1 (enabled), players must have completed the Death Knight starting zone to receive the bonus experience.
#     Default: 0 (Disabled)

XPWeekend.IsDKStartZoneRequired = 0

# XPWeekend.IsJoyousJourneysActive = 0
#     Promotional event, adds yet another layer of bonus on top of the current bonus (yay!)
#     Ignored while a window is set with the `.weekendxp joyousjourneys schedule`
#     command; the scheduled window decides whether the event is active instead.
#     Default: 0 (Disabled)

XPWeekend.IsJoyousJourneysActive = 0

# XPWeekend.JoyousJourneysXPRate = 1
#     Bonus experience rate during joyous journeys.
#     ADDS to the base one. So if base 2x + 1x from this = 3x (50% increase).
#     Default: 1

XPWeekend.JoyousJourneysXPRate = 1

# XPWeekend.JoyousJourneysRepRate = 1.10
#     Reputation bonus while joyous journeys is active.
#     Default: 1.10 (10%)

XPWeekend.JoyousJourneysRepRate = 1.10

# XPWeekend.ExcludeInsaneReps = 1
#     Exclude the insane title reputations e.g ravenholdt
#     Default: 1 (Enabled)

XPWeekend.ExcludeInsaneReps = 1
